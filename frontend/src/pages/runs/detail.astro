---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Run Details" activeNav="runs">
  <div class="max-w-6xl mx-auto space-y-6">
    <!-- Header with controls -->
    <div class="flex items-center justify-between pb-4 border-b border-[#262938]">
      <div class="flex items-center gap-3">
        <a href="/runs" class="p-2 rounded-lg bg-[#202330] hover:bg-[#2b2f42] text-gray-400 hover:text-white transition">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-xl font-bold text-white font-mono" id="run-header-title">Run #...</h1>
            <span id="run-status-badge" class="text-xs px-2.5 py-0.5 rounded-full border bg-gray-500/10 text-gray-400 font-medium capitalize">
              Loading...
            </span>
          </div>
          <p class="text-xs text-gray-400 mt-1" id="run-group-url">Loading target URL...</p>
        </div>
      </div>

      <div class="flex items-center gap-3" id="run-action-buttons">
        <button
          id="cancel-run-btn"
          class="hidden items-center gap-2 px-3.5 py-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-semibold transition"
        >
          <i data-lucide="square" class="w-3.5 h-3.5 fill-current"></i>
          Cancel Run
        </button>

        <button
          id="retry-run-btn"
          class="hidden items-center gap-2 px-3.5 py-2 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/30 text-xs font-semibold transition"
        >
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          Retry Run
        </button>

        <a
          id="view-dataset-btn"
          href="/datasets"
          class="flex items-center gap-2 px-4 py-2 rounded-lg bg-[#FF7629] hover:bg-[#e66319] text-white text-xs font-semibold transition shadow-md shadow-[#FF7629]/20"
        >
          <i data-lucide="database" class="w-3.5 h-3.5"></i>
          View Scraped Posts
        </a>
      </div>
    </div>

    <!-- Metadata Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-[#1b1e2b] p-4 rounded-xl border border-[#262938]">
        <div class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Posts Scraped</div>
        <div class="text-xl font-bold text-white mt-1" id="run-stat-posts">0 / 0</div>
      </div>
      <div class="bg-[#1b1e2b] p-4 rounded-xl border border-[#262938]">
        <div class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Duration</div>
        <div class="text-xl font-bold text-white mt-1 font-mono" id="run-stat-duration">00:00</div>
      </div>
      <div class="bg-[#1b1e2b] p-4 rounded-xl border border-[#262938]">
        <div class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Process ID (PID)</div>
        <div class="text-xl font-bold text-blue-400 mt-1 font-mono" id="run-stat-pid">-</div>
      </div>
      <div class="bg-[#1b1e2b] p-4 rounded-xl border border-[#262938]">
        <div class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Target Database</div>
        <div class="text-xl font-bold text-emerald-400 mt-1 font-mono">Port 8092</div>
      </div>
    </div>

    <!-- Live Logs Terminal Viewer -->
    <div class="bg-[#12141c] rounded-xl border border-[#262938] overflow-hidden flex flex-col h-[520px]">
      <div class="p-3 bg-[#181a24] border-b border-[#262938] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <i data-lucide="terminal" class="w-4 h-4 text-[#FF7629]"></i>
          <span class="text-xs font-semibold text-white font-mono">Live Execution Console</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse ml-2" id="live-indicator"></span>
        </div>
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 text-xs text-gray-400 cursor-pointer">
            <input type="checkbox" id="autoscroll-toggle" checked class="rounded border-gray-700 bg-gray-900 text-[#FF7629]" />
            Auto-scroll
          </label>
          <button
            id="clear-logs-btn"
            class="text-xs text-gray-500 hover:text-gray-300 font-mono transition"
          >
            Clear
          </button>
        </div>
      </div>

      <!-- Logs content -->
      <div class="flex-1 p-4 font-['JetBrains_Mono',monospace] text-xs overflow-y-auto space-y-1.5 text-gray-300" id="logs-container">
        <div class="text-gray-600 italic">Waiting for scraper worker connection...</div>
      </div>
    </div>
  </div>

  <script>
    // Extract run ID from query parameter (?runId=...)
    const urlParams = new URLSearchParams(window.location.search);
    let runId = urlParams.get("runId");
    if (!runId) {
      const parts = window.location.pathname.split("/").filter(Boolean);
      runId = parts[parts.length - 1];
    }

    const runTitle = document.getElementById("run-header-title");
    const statusBadge = document.getElementById("run-status-badge");
    const groupUrlEl = document.getElementById("run-group-url");
    const statPosts = document.getElementById("run-stat-posts");
    const statDuration = document.getElementById("run-stat-duration");
    const statPid = document.getElementById("run-stat-pid");
    const cancelBtn = document.getElementById("cancel-run-btn");
    const retryBtn = document.getElementById("retry-run-btn");
    const viewDatasetBtn = document.getElementById("view-dataset-btn") as HTMLAnchorElement;
    const logsContainer = document.getElementById("logs-container");
    const autoscrollToggle = document.getElementById("autoscroll-toggle") as HTMLInputElement;

    let eventSource: EventSource | null = null;
    let seenLogIds = new Set<string>();

    async function loadRunDetails() {
      try {
        const res = await fetch(`http://127.0.0.1:4000/api/runs/${runId}`);
        if (!res.ok) return;
        const data = await res.json();
        const run = data.run;

        runTitle!.innerText = `Run #${run.id.slice(0, 8)}`;
        groupUrlEl!.innerText = run.group_url;
        statPosts!.innerText = `${run.scraped_count || 0} / ${run.post_limit}`;
        statDuration!.innerText = run.duration || (run.status === "running" ? "In progress" : "-");
        statPid!.innerText = run.pid ? String(run.pid) : "-";
        viewDatasetBtn.href = `/datasets?runId=${run.id}`;

        const statusBadges: Record<string, string> = {
          completed: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
          running: "bg-blue-500/10 text-blue-400 border-blue-500/20",
          failed: "bg-rose-500/10 text-rose-400 border-rose-500/20",
          cancelled: "bg-amber-500/10 text-amber-400 border-amber-500/20",
          pending: "bg-gray-500/10 text-gray-400 border-gray-500/20"
        };
        statusBadge!.className = `text-xs px-2.5 py-0.5 rounded-full border capitalize font-medium ${statusBadges[run.status] || ""}`;
        statusBadge!.innerText = run.status;

        // Button visibility
        if (run.status === "running") {
          cancelBtn?.classList.remove("hidden");
          cancelBtn?.classList.add("flex");
          retryBtn?.classList.add("hidden");
        } else {
          cancelBtn?.classList.add("hidden");
          retryBtn?.classList.remove("hidden");
          retryBtn?.classList.add("flex");
          document.getElementById("live-indicator")?.classList.remove("animate-pulse", "bg-emerald-400");
          document.getElementById("live-indicator")?.classList.add("bg-gray-600");
        }

        // Render initial historical logs
        if (data.logs && data.logs.length > 0) {
          data.logs.forEach((log: any) => appendLog(log));
        }

        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      } catch (e) {
        console.error("Error loading run details:", e);
      }
    }

    function appendLog(log: any) {
      if (seenLogIds.has(log.id)) return;
      seenLogIds.add(log.id);

      if (logsContainer?.children[0]?.classList?.contains("italic")) {
        logsContainer.innerHTML = "";
      }

      const logRow = document.createElement("div");
      logRow.className = "flex items-start gap-2 leading-relaxed";

      const time = log.timestamp ? new Date(log.timestamp).toLocaleTimeString() : "";
      const levelColors: Record<string, string> = {
        INFO: "text-blue-400",
        WARN: "text-amber-400",
        ERROR: "text-rose-400"
      };

      logRow.innerHTML = `
        <span class="text-gray-500 shrink-0">[${time}]</span>
        <span class="font-bold ${levelColors[log.level] || 'text-gray-400'} shrink-0">[${log.level || 'INFO'}]</span>
        <span class="text-gray-200 break-words">${log.message}</span>
      `;

      logsContainer?.appendChild(logRow);

      if (autoscrollToggle.checked) {
        logsContainer!.scrollTop = logsContainer!.scrollHeight;
      }
    }

    function connectSSE() {
      if (eventSource) eventSource.close();
      eventSource = new EventSource(`http://127.0.0.1:4000/api/runs/${runId}/logs/stream`);

      eventSource.onmessage = (event) => {
        try {
          const logs = JSON.parse(event.data);
          if (Array.isArray(logs)) {
            logs.forEach(appendLog);
          }
        } catch (e) {}
      };

      eventSource.addEventListener("done", (event) => {
        eventSource?.close();
        loadRunDetails();
      });

      eventSource.onerror = () => {
        // SSE disconnected
      };
    }

    // Cancel action
    cancelBtn?.addEventListener("click", async () => {
      if (!confirm("Are you sure you want to terminate this scraping run?")) return;
      try {
        await fetch(`http://127.0.0.1:4000/api/runs/${runId}/cancel`, { method: "POST" });
        loadRunDetails();
      } catch (e) {
        alert("Failed to cancel run.");
      }
    });

    // Retry action
    retryBtn?.addEventListener("click", async () => {
      try {
        const res = await fetch(`http://127.0.0.1:4000/api/runs/${runId}/retry`, { method: "POST" });
        const data = await res.json();
        if (data.newRunId) {
          window.location.href = `/runs/detail?runId=${data.newRunId}`;
        }
      } catch (e) {
        alert("Failed to retry run.");
      }
    });

    document.getElementById("clear-logs-btn")?.addEventListener("click", () => {
      logsContainer!.innerHTML = "";
    });

    loadRunDetails();
    connectSSE();
    setInterval(loadRunDetails, 3000);
  </script>
</DashboardLayout>

