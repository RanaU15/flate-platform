---
interface Props {
  title?: string;
  activeNav?: string;
}

const { title = "Facebook Group Scraper Platform", activeNav = "overview" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Apify Console</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="bg-[#11131a] text-gray-200 font-['Inter',sans-serif] min-h-screen flex antialiased">
    <!-- Sidebar -->
    <aside class="w-64 bg-[#181a24] border-r border-[#262938] flex flex-col justify-between shrink-0 h-screen sticky top-0">
      <div>
        <!-- Logo & Brand -->
        <div class="h-16 flex items-center px-6 border-b border-[#262938] gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#FF7629] to-[#FF9E66] flex items-center justify-center font-bold text-white shadow-md shadow-[#FF7629]/20">
            A
          </div>
          <div>
            <h1 class="text-sm font-semibold text-white tracking-wide flex items-center gap-2">
              Apify Console
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono border border-emerald-500/20">v2.0</span>
            </h1>
            <p class="text-xs text-gray-400">FB Scraper Cloud</p>
          </div>
        </div>

        <!-- Navigation Links -->
        <nav class="p-3 space-y-1 text-sm font-medium">
          <a
            href="/"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg transition-colors ${
              activeNav === "overview"
                ? "bg-[#252838] text-white font-semibold shadow-inner"
                : "text-gray-400 hover:text-gray-200 hover:bg-[#202330]"
            }`}
          >
            <i data-lucide="layout-dashboard" class="w-4 h-4 text-[#FF7629]"></i>
            Overview
          </a>

          <a
            href="/actors"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg transition-colors ${
              activeNav === "actors"
                ? "bg-[#252838] text-white font-semibold"
                : "text-gray-400 hover:text-gray-200 hover:bg-[#202330]"
            }`}
          >
            <i data-lucide="box" class="w-4 h-4 text-[#FF7629]"></i>
            Actors
          </a>

          <a
            href="/runs"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg transition-colors ${
              activeNav === "runs"
                ? "bg-[#252838] text-white font-semibold"
                : "text-gray-400 hover:text-gray-200 hover:bg-[#202330]"
            }`}
          >
            <i data-lucide="play-circle" class="w-4 h-4 text-[#FF7629]"></i>
            Runs
          </a>

          <a
            href="/datasets"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg transition-colors ${
              activeNav === "datasets"
                ? "bg-[#252838] text-white font-semibold"
                : "text-gray-400 hover:text-gray-200 hover:bg-[#202330]"
            }`}
          >
            <i data-lucide="database" class="w-4 h-4 text-[#FF7629]"></i>
            Datasets
          </a>

          <a
            href="/settings"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg transition-colors ${
              activeNav === "settings"
                ? "bg-[#252838] text-white font-semibold"
                : "text-gray-400 hover:text-gray-200 hover:bg-[#202330]"
            }`}
          >
            <i data-lucide="settings" class="w-4 h-4 text-[#FF7629]"></i>
            Settings
          </a>
        </nav>
      </div>

      <!-- System Status Footer -->
      <div class="p-4 border-t border-[#262938]">
        <div class="bg-[#1e202d] rounded-lg p-3 text-xs border border-[#2b2e40] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-gray-400">PocketBase DB</span>
            <span class="flex items-center gap-1.5 text-emerald-400 font-mono font-medium">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              :8092
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Node API Engine</span>
            <span class="text-emerald-400 font-mono font-medium">:4000</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Python Engine</span>
            <span class="text-blue-400 font-mono font-medium">Ready</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header -->
      <header class="h-16 border-b border-[#262938] bg-[#181a24]/80 backdrop-blur px-8 flex items-center justify-between sticky top-0 z-30">
        <div class="flex items-center gap-3">
          <h2 class="text-base font-semibold text-white capitalize">{activeNav}</h2>
          <span class="text-gray-500">/</span>
          <span class="text-xs text-gray-400">facebook-groups-scraper-v1</span>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="/actors"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md bg-[#FF7629] text-white text-xs font-semibold hover:bg-[#f0681b] transition shadow-md shadow-[#FF7629]/20"
          >
            <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
            Run Actor
          </a>
          <a
            href="http://127.0.0.1:8092/_/"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#222534] text-gray-300 text-xs font-medium hover:bg-[#2b2f42] border border-[#2e3347] transition"
          >
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            PocketBase Admin
          </a>
        </div>
      </header>

      <!-- Page Body -->
      <main class="flex-1 p-8 overflow-y-auto">
        <slot />
      </main>
    </div>

    <script>
      // Initialize Lucide icons
      document.addEventListener("DOMContentLoaded", () => {
        // @ts-ignore
        if (window.lucide) {
          // @ts-ignore
          window.lucide.createIcons();
        }
      });
    </script>
  </body>
</html>

